APP_NAME=History & Social Studies Teacher Assistant
APP_ENV=dev
DATABASE_URL=postgresql+asyncpg://teacher:teacher@localhost:5432/teacher_assistant
AUTO_CREATE_TABLES=true

SOURCE_STORAGE_DIR=data/source_files
EMBEDDING_PROVIDER=hash
EMBEDDING_MODEL=hash-384-v1
EMBEDDING_DIM=384
EMBEDDING_BATCH_SIZE=64
EMBEDDING_HTTP_BASE_URL=
EMBEDDING_HTTP_API_KEY=
EMBEDDING_HTTP_MODEL=
RETRIEVAL_CANDIDATE_K=40
RETRIEVAL_TOP_K=8
RETRIEVAL_LANGUAGE_CONFIG=russian
GENERATION_PROVIDER=openai_responses
GENERATION_MODEL=template-lesson-v1
GENERATION_HTTP_BASE_URL=
GENERATION_HTTP_API_KEY=
GENERATION_HTTP_MODEL=
GENERATION_HTTP_TIMEOUT_SECONDS=90
GENERATION_TEMPERATURE=0.2
OUTPUT_STORAGE_DIR=data/generated_outputs
OUTPUT_TEMPLATE=school_clean
OUTPUT_FONT_NAME=Liberation Sans
OUTPUT_KEEP_INTERMEDIATE_DOCX_FOR_PDF=true
LIBREOFFICE_BINARY=soffice
OPENAI_API_KEY=
OPENAI_RESPONSES_BASE_URL=https://api.openai.com/v1
WEB_SEARCH_PROVIDER=openai
WEB_SEARCH_MODEL=gpt-5.6-luna
WEB_SEARCH_CONTEXT_SIZE=low
WEB_SEARCH_TIMEOUT_SECONDS=90
WEB_FALLBACK_MIN_LOCAL_HITS=2
WEB_ALLOW_GENERAL_AFTER_OFFICIAL=true
WEB_MAX_SOURCES=12
OPENAI_GENERATION_MODEL=gpt-5.6-terra
OPENAI_GENERATION_REASONING_EFFORT=medium
OPENAI_GENERATION_TIMEOUT_SECONDS=120
OPENAI_GENERATION_MAX_RETRIES=1
PILOT_RELEASE_LABEL=1.0-beta
ADMIN_API_KEY=replace-with-a-long-random-secret
TELEGRAM_BOT_TOKEN=
TELEGRAM_BACKEND_BASE_URL=http://127.0.0.1:8000
TELEGRAM_REQUEST_TIMEOUT_SECONDS=240
TELEGRAM_DEFAULT_FORMATS=docx
TELEGRAM_ADMIN_IDS=
TELEGRAM_BETA_NOTICE=true
